# Primary for Drizzle / app (Neon pooled URI is fine)
DATABASE_URL='postgres://role:password@localhost:5432/db-name'
# Vercel + Neon often set one of these instead; the app accepts them in this order:
# POSTGRES_URL, NEON_DATABASE_URL, POSTGRES_PRISMA_URL, POSTGRES_URL_NON_POOLING
BETTER_AUTH_SECRET="Random value used by the library for encryption and generating hashes. you can use something like openssl"
# Must be the public site origin (no trailing slash). Production: https://your-domain.com — used for OAuth redirect_uri.
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID="" # Google OAuth Web Client ID
GOOGLE_CLIENT_SECRET="" # Google OAuth Web Client Secret
# In Google Cloud Console → Credentials → your Web client → Authorized redirect URIs, add:
#   {BETTER_AUTH_URL or NEXT_PUBLIC_APP_URL}/api/auth/callback/google
# e.g. https://your-app.vercel.app/api/auth/callback/google
# Optional: only if the browser origin differs from where /api/auth is hosted (rare for this app).
# NEXT_PUBLIC_BETTER_AUTH_URL="https://api.example.com"
CHARGILY_SECRET_KEY="" # Chargily secret key (test or live)
CHARGILY_API_BASE_URL="https://pay.chargily.net/test/api/v2" # Test mode base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000" # Payments/SSR; canonical + Product JSON-LD (absolute URLs); Vercel also sets VERCEL_URL as fallback
# NEXT_PUBLIC_STORE_BRAND="" # Brand/seller label in structured data (defaults to “Vitrina Store” when unset)
# NEXT_PUBLIC_BASE_PATH="" # GitHub Pages subpath only, e.g. /repo-name — must match Next basePath if set
# Optional: comma-separated emails that always see the Admin nav client-side (still need role=admin in DB for APIs)
# NEXT_PUBLIC_ADMIN_EMAILS="youcefyouyou201588@gmail.com"
# OpenRouter (Seller Helper LLM analysis + assistant freeflow)
# OPENROUTER_API_KEY=""
# CONCEPTION_OPENROUTER_MODEL="google/gemini-2.0-flash-001"
# CONCEPTION_GEMINI_MODEL="gemini-2.0-flash"
# GOOGLE_API_KEY="" # optional fallback when OpenRouter has no credits
# CONCEPTION_LLM_GEMINI_FALLBACK="false" # default: fallback only on OpenRouter 402
# ASSISTANT_FREEFLOW_MODEL="openrouter/auto"
# Dev only: live inventory GET always returns 0 (test out-of-stock UI). Never enable in production.
# FORCE_CATALOG_INVENTORY_ZERO=1
# Moosend — automated recommendation emails (https://souma.moosend.com)
# API key: Moosend → More → Settings → API key (see https://docs.moosend.com/api-documentation/articles/KnowledgeBase/54498-use-the-api-key-to-connect-to-the-moosend-web-api)
# MOOSEND_API_KEY="your-api-key-guid"
# Website/domain from dashboard (reference): https://souma.moosend.com/websites/domain/432057e2-9b81-45f8-853c-e9c4fe9432e7
# MOOSEND_DOMAIN_ID="432057e2-9b81-45f8-853c-e9c4fe9432e7"
# Verified sender on that domain (required for delivery)
# EMAIL_FROM="Vitrina Store <notifications@your-verified-domain.com>"
# Required: transactional campaign created in Moosend (Campaigns → Transactional → New)
# Copy the campaign GUID from the campaign URL or settings into Template ID:
# MOOSEND_TRANSACTIONAL_TEMPLATE_ID="6e3d31b7-418a-466f-9b22-c33a8de3ec93"
# Or use the exact campaign name instead:
# MOOSEND_TRANSACTIONAL_TEMPLATE_NAME="Vitrina AI Recommendations"
# MOOSEND_API_HOST="https://api.moosend.com"
# Auto-email each new recommendation after Analyze (default on when MOOSEND_API_KEY is set)
# MOOSEND_AUTO_SEND_ON_ANALYZE="true"
# Website verification (Websites → your site → Install connection script → copy the init GUID)
# Website verification (mootrack init GUID from Moosend custom install script)
# NEXT_PUBLIC_MOOSEND_TRACKING_ID="432057e2-9b81-45f8-853c-e9c4fe9432e7"